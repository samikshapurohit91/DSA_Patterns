General Template

int left = 0;
int right = arr.length - 1;

while(left < right){

    // Check condition

    if(condition){
        left++;
    }
    else{
        right--;
    }
}

---

Common Patterns

Pattern 1: Find Pair in Sorted Array

while(left < right){

    int sum = arr[left] + arr[right];

    if(sum == target)
        return true;

    else if(sum < target)
        left++;

    else
        right--;
}

---

Pattern 2: Remove Duplicates

int slow = 0;

for(int fast = 1; fast < nums.length; fast++){

    if(nums[fast] != nums[slow]){
        slow++;
        nums[slow] = nums[fast];
    }
}

---

Pattern 3: Reverse Array

while(left < right){

    int temp = arr[left];
    arr[left] = arr[right];
    arr[right] = temp;

    left++;
    right--;
}

